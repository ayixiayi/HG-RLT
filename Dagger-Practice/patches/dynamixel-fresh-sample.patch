+    def get_joint_sample(self) -> Tuple[np.ndarray, float]:
+        """Return a copied hardware sample in radians and its monotonic time.
+
+        Raises RuntimeError for fake, missing/invalid samples or if the sample
+        lock cannot be acquired within 10 ms. Never waits for serial I/O;
+        callers must check the returned timestamp against their freshness limit.
+        """
+        if self._is_fake:
+            raise RuntimeError("Fake Dynamixel driver has no hardware joint sample")
+        if not self._sample_lock.acquire(timeout=0.01):
+            raise RuntimeError("Dynamixel joint sample lock is busy")
+        try:
+            stamp = self._joint_sample_time
+            angles = self._joint_angles
+            if (
+                stamp is None
+                or not np.isfinite(stamp)
+                or stamp < 0
+                or angles is None
+                or angles.shape != (len(self._ids),)
+                or not np.all(np.isfinite(angles))
+            ):
+                raise RuntimeError("No complete valid Dynamixel joint sample")
+            return angles.copy() / 2048.0 * np.pi, stamp
+        finally:
+            self._sample_lock.release()
+
     def get_positions_and_velocities(self) -> Tuple[np.ndarray, np.ndarray]:
         if self._is_fake:
             return self._fake_joint_angles.copy(), self._fake_velocities.copy()
