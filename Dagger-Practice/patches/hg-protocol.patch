+"""Strict bounded transport (operation_timeout_s) for WsModelClient.
+
+Runs the real WsModelClient against fake protocol clients/connections on an
+in-process loop; nothing here opens a socket or touches hardware.
+"""
+
+import asyncio
+import gc
+import logging
+import sys
+import threading
+import time
+from dataclasses import fields
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "XPolicyLab"))
+
+from client_server.ws import model_client as model_client_module
+from client_server.ws.model_client import (
+    STRICT_CLEANUP_GRACE_S,
+    WsModelClient,
+)
+from client_server.ws.protocol import client as protocol_client
+from client_server.ws.protocol.client import (
+    PolicyEvalClient,
+    PolicyEvalClientConfig,
+)
+
+BUDGET_S = 0.2
+# Allowance for thread scheduling on a loaded CI box; not a real-time claim.
+SLOP_S = 0.35
+BOUND_S = BUDGET_S + STRICT_CLEANUP_GRACE_S + SLOP_S
+
+
+CANCELLED = []
+
+
+async def _forever():
+    try:
+        await asyncio.Event().wait()
+    except asyncio.CancelledError:
+        CANCELLED.append(asyncio.current_task().get_name())
+        raise
+
+
+async def _ignore_cancellation():
+    while True:
+        try:
+            await asyncio.sleep(10)
+        except asyncio.CancelledError:
+            continue
+
+
+class FakeProtocolClient:
+    def __init__(self, *, connect=None, reset=None, infer=None, close=None):
+        self.hooks = {"connect": connect, "reset": reset, "infer": infer, "close": close}
+        self.calls = []
+
+    async def _hook(self, name):
+        hook = self.hooks[name]
+        if hook is not None:
+            await hook()
+
+    async def connect(self, handshake=True):
+        self.calls.append("connect")
+        await self._hook("connect")
+
+    async def reset(self, **kwargs):
+        self.calls.append(("reset", kwargs))
+        await self._hook("reset")
+        return SimpleNamespace(payload={"result": "reset-ok"})
+
+    async def infer(self, obs, **kwargs):
+        self.calls.append(("infer", kwargs["step"]))
+        await self._hook("infer")
+        return SimpleNamespace(payload={"actions": [[float(kwargs["step"])] * 14]})
+
+    async def close(self):
+        self.calls.append("close")
+        await self._hook("close")
+
+
+def _strict(fake, budget=BUDGET_S):
+    return WsModelClient(
+        url="ws://unused", evaluation_id="e", trial_id="t", client=fake,
+        operation_timeout_s=budget,
+    )
+
+
+def _timed(fn):
+    started = time.monotonic()
+    try:
+        fn()
+    except BaseException as exc:  # noqa: BLE001 - returned for assertions
+        return exc, time.monotonic() - started
+    return None, time.monotonic() - started
+
+
+def _ws_threads():
+    return [t for t in threading.enumerate() if t.name == "ws-model-client"]
+
+
+def test_strict_success_reset_infer_close():
+    fake = FakeProtocolClient()
+    client = _strict(fake, budget=2.0)
+    assert client.call("reset") == "reset-ok"
+    assert client.call("get_action", obs={"state": [0.0]}) == [[0.0] * 14]
+    assert client.call("get_action", obs={"state": [0.0]}) == [[1.0] * 14]
+    assert client.terminal_error is None
+    client.close()
+    client.close()  # idempotent
+    assert client._loop.is_closed() and not client._loop_thread.is_alive()
+    assert [c for c in fake.calls if c != "close"] == [
+        "connect", ("reset", {"trial_id": "t", "action_case_id": None, "repeat_index": None}),
+        ("infer", 0), ("infer", 1),
+    ]
+
+
+def test_connect_that_never_completes_is_bounded_and_cancelled():
+    before = len(_ws_threads())
+    CANCELLED.clear()
+    fake = FakeProtocolClient(connect=_forever)
+    exc, elapsed = _timed(lambda: _strict(fake))
+    assert isinstance(exc, TimeoutError)
+    assert "operation_timeout_s=0.2s" in str(exc)
+    assert BUDGET_S <= elapsed < BOUND_S
+    assert CANCELLED  # the pending connect was cancelled, not abandoned
+    assert fake.calls == ["connect", "close"]  # best-effort protocol close
+    time.sleep(0.05)
+    assert len(_ws_threads()) == before
+
+
+def test_task_ignoring_cancellation_is_bounded_and_reported(caplog):
+    before = len(_ws_threads())
+    with pytest.warns(RuntimeWarning, match="ignored cancellation"):
+        exc, elapsed = _timed(lambda: _strict(FakeProtocolClient(connect=_ignore_cancellation)))
+    assert isinstance(exc, TimeoutError)
+    assert BUDGET_S <= elapsed < BOUND_S
+    time.sleep(0.05)
+    assert len(_ws_threads()) == before
+    # The abandoned task is destroyed with its closed loop and asyncio logs
+    # it: a real, reported leak of a noncooperative coroutine, not hidden.
+    del exc  # its traceback keeps the task alive via the chained future
+    gc.collect()
+    assert any("Task was destroyed but it is pending" in r.getMessage()
+               for r in caplog.records if r.name == "asyncio")
+
+
+def test_wedged_loop_thread_still_returns_on_time(caplog):
+    loops = []
+
+    async def block_loop_thread():
+        loops.append(asyncio.get_running_loop())
+        time.sleep(BUDGET_S + STRICT_CLEANUP_GRACE_S + 0.5)  # noqa: ASYNC251
+
+    before = set(_ws_threads())
+    fake = FakeProtocolClient(connect=block_loop_thread)
+    exc, elapsed = _timed(lambda: _strict(fake))
+    assert isinstance(exc, TimeoutError)
+    assert elapsed < BOUND_S
+    # The caller is released on time, but the wedged daemon thread lingers
+    # until the blocking call returns (documented limit) ...
+    lingering = set(_ws_threads()) - before
+    assert lingering
+    assert not loops[0].is_closed()
+    for thread in lingering:
+        thread.join(timeout=2.0)
+        assert not thread.is_alive()
+    # ... and then finishes teardown itself: protocol close, loop closed,
+    # nothing left pending or never awaited.
+    assert loops[0].is_closed()
+    assert fake.calls == ["connect", "close"]
+    del exc
+    gc.collect()
+    # (Debug-mode "Executing ... took" WARNINGs for the blocking call are fine.)
+    assert not [r for r in caplog.records
+                if r.name == "asyncio" and r.levelno >= logging.ERROR]
+
+
+@pytest.mark.parametrize("op", ["reset", "infer"])
+def test_stalled_request_latches_and_blocks_later_requests(op):
+    CANCELLED.clear()
+    fake = FakeProtocolClient(**{op: _forever})
+    client = _strict(fake)
+    request = (lambda: client.call("reset")) if op == "reset" else (
+        lambda: client.call("get_action", obs={"state": [0.0]})
+    )
+    exc, elapsed = _timed(request)
+    assert isinstance(exc, TimeoutError)
+    assert BUDGET_S <= elapsed < BOUND_S
+    assert client.terminal_error is exc
+    assert CANCELLED  # the stalled request coroutine was cancelled
+    sent = list(fake.calls)
+    for later in (lambda: client.call("reset"),
+                  lambda: client.call("get_action", obs={"state": [0.0]})):
+        with pytest.raises(RuntimeError, match="unusable") as info:
+            later()
+        assert info.value.__cause__ is exc
+    # Nothing new reached the protocol client: no retry under a fresh ID.
+    assert fake.calls == sent
+    assert sent[-1] == "close"  # teardown closed the protocol client
+    _, close_elapsed = _timed(client.close)
+    assert close_elapsed < 0.05
+    assert not client._loop_thread.is_alive()
+    assert client._loop.is_closed()
+
