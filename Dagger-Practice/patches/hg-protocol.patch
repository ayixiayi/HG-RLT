+def test_closed_strict_client_rejects_requests_without_sending(caplog):
+    fake = FakeProtocolClient()
+    client = _strict(fake, budget=2.0)
+    client.close()
+    assert client._loop.is_closed() and not client._loop_thread.is_alive()
+    sent = list(fake.calls)
+    assert sent.count("close") == 1  # successful close is not repeated in teardown
+    with pytest.raises(RuntimeError, match="not running"):
+        client.call("reset")
+    with pytest.raises(RuntimeError, match="not running"):
+        client.call("get_action", obs={"state": [0.0]})
+    assert fake.calls == sent
+    gc.collect()
+    assert not [r for r in caplog.records
+                if r.name == "asyncio" and r.levelno >= logging.ERROR]
+
