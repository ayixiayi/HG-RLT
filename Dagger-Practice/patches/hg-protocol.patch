+def test_stalled_close_is_bounded():
+    CANCELLED.clear()
+    client = _strict(FakeProtocolClient(close=_forever))
+    exc, elapsed = _timed(client.close)
+    assert isinstance(exc, TimeoutError)
+    assert BUDGET_S <= elapsed < BOUND_S
+    assert CANCELLED
+    assert not client._loop_thread.is_alive()
+    assert client._loop.is_closed()
+    client.close()  # already torn down: returns immediately
