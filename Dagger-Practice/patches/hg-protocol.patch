+class _HangingSendWs:
+    async def send(self, message, text=None):
+        await asyncio.Event().wait()
+
+    async def close(self):
+        await asyncio.Event().wait()
+
+    def __aiter__(self):
+        return self
+
+    async def __anext__(self):
+        await asyncio.Event().wait()
+
+
+class _FailingSendWs(_HangingSendWs):
+    async def send(self, message, text=None):
+        raise ConnectionError("send failed")
+
+    async def close(self):
+        return None
+
+
+def _real_protocol_client(ws):
+    # Legacy long knobs on purpose: only the outer operation budget bounds it.
+    client = PolicyEvalClient(PolicyEvalClientConfig(url="ws://unused", evaluation_id="e"))
+    client._ws = ws  # connect() is then a no-op; no socket is opened
+    return client
+
+
+def test_real_protocol_send_that_never_completes_is_bounded():
+    proto = _real_protocol_client(_HangingSendWs())
+    client = _strict(proto)
+    exc, elapsed = _timed(lambda: client.call("get_action", obs={"state": [0.0]}))
+    assert isinstance(exc, TimeoutError)
+    # Cleanup's protocol close() also stalls on send/close; still bounded.
+    assert BUDGET_S <= elapsed < BOUND_S
+    assert proto._closed
+    assert not client._loop_thread.is_alive()
+
+
+def test_real_protocol_reconnect_that_never_completes_is_bounded(monkeypatch):
+    attempts = []
+
+    async def never_connect(*args, **kwargs):
+        attempts.append(args)
+        await asyncio.Event().wait()
+
+    monkeypatch.setattr(protocol_client.websockets, "connect", never_connect)
+    proto = _real_protocol_client(_FailingSendWs())
+    client = _strict(proto)
+    exc, elapsed = _timed(lambda: client.call("reset"))
+    assert isinstance(exc, TimeoutError)
+    assert BUDGET_S <= elapsed < BOUND_S
+    assert len(attempts) == 1
+    time.sleep(0.3)
+    assert len(attempts) == 1  # no orphaned retry loop
+    assert proto._closed
+
