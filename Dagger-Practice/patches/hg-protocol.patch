+"""Follower CAN receive-time propagation, checked without hardware.
+
+Real DM driver / MotorChainRobot / YAM / Bimanual classes are instantiated with
+``__new__`` and fed fake CAN reply frames; no bus, thread, GPU or service is
+started. ``received_monotonic_s`` is host decode time, not encoder sampling time.
+"""
+
+import sys
+import threading
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+YAM_ROOT = Path(__file__).resolve().parents[1] / "Client" / "arms" / "YAM"
+sys.path.insert(0, str(YAM_ROOT / "i2rt"))
+sys.path.insert(0, str(YAM_ROOT / "gello_software"))
+
+from i2rt.motor_drivers import dm_driver  # noqa: E402
+from i2rt.motor_drivers.dm_driver import (  # noqa: E402
+    DMChainCanInterface,
+    DMSingleMotorCanInterface,
+    MotorCmd,
+)
+from i2rt.motor_drivers.utils import (  # noqa: E402
+    MotorType,
+    ReceiveMode,
+    uint_to_float,
+)
+from i2rt.robots import motor_chain_robot as mcr  # noqa: E402
+from i2rt.robots.motor_chain_robot import JointCommands, MotorChainRobot  # noqa: E402
+from i2rt.robots.utils import JointMapper  # noqa: E402
+
+from gello.robots.robot import BimanualRobot  # noqa: E402
+from gello.robots.yam import YAMRobot  # noqa: E402
+
+N = 7
+MOTOR_IDS = list(range(1, N + 1))
+# Asymmetric raw 16-bit position codes, one per motor.
+P_INTS = [33000, 31000, 40000, 25000, 36000, 30000, 34500]
+DIRECTIONS = np.array([1, -1, 1, 1, -1, 1, 1], dtype=float)
+OFFSETS = np.array([0.1, -0.2, 0.0, 0.3, 0.05, -0.1, 0.2])
+GRIPPER_LIMITS = np.array([-0.3, 2.5])  # closed, open
+
+
+class FakeClock:
+    def __init__(self, mono=1000.0, wall=5_000_000.0):
+        self.mono = mono
+        self.wall = wall
+
+    def monotonic(self):
+        return self.mono
+
+    def time(self):
+        return self.wall
+
+    def sleep(self, _s):
+        pass
+
+
+def frame(motor_id, p_int, error=0x1):
+    v_int, t_int = 2048, 2048
+    data = [
+        (error << 4) | (motor_id & 0xF),
+        (p_int >> 8) & 0xFF,
+        p_int & 0xFF,
+        (v_int >> 4) & 0xFF,
+        ((v_int & 0xF) << 4) | (t_int >> 8),
+        t_int & 0xFF,
+        30,
+        31,
+    ]
+    return SimpleNamespace(arbitration_id=ReceiveMode.p16.get_receive_id(motor_id), data=bytearray(data))
+
+
+def raw_pos(p_int):
+    c = MotorType.get_motor_constants(MotorType.DM4310)
+    return uint_to_float(p_int, c.POSITION_MIN, c.POSITION_MAX, 16)
+
+
+def make_single():
+    single = DMSingleMotorCanInterface.__new__(DMSingleMotorCanInterface)
+    single.receive_mode = ReceiveMode.p16
+    single.name = "fake"
+    single.bus = SimpleNamespace(channel_info="fake")
+    return single
+
+
+class ScriptedInterface:
+    """Fake CAN transport: each set_control returns the real decode of a scripted reply."""
+
+    def __init__(self, single, clock, chain_ref):
+        self.single = single
+        self.clock = clock
+        self.chain_ref = chain_ref
+        self.cycles = []  # list of {motor_id: (p_int, error, mono) or Exception}
+        self.cycle = 0
+
+    def set_control(self, motor_id, motor_type, pos, vel, kp, kd, torque):
+        item = self.cycles[self.cycle][motor_id]
+        if isinstance(item, Exception):
+            raise item
+        p_int, error, mono = item
+        self.clock.mono = mono
+        info = self.single.parse_recv_message(frame(motor_id, p_int, error), motor_type)
+        if motor_id == MOTOR_IDS[-1]:
+            self.cycle += 1
+            if self.cycle == len(self.cycles):
+                self.chain_ref[0].running = False
+        return info
+
+
+class Recorder:
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def track(self):
+        pass
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    c = FakeClock()
+    monkeypatch.setattr(dm_driver, "time", c)
+    return c
+
+
+def make_chain(clock):
+    chain = DMChainCanInterface.__new__(DMChainCanInterface)
+    chain.motor_list = [[mid, MotorType.DM4310] for mid in MOTOR_IDS]
+    chain.motor_direction = DIRECTIONS.copy()
+    chain.motor_offset = OFFSETS.copy()
+    chain.state_lock = threading.Lock()
+    chain.command_lock = threading.RLock()
+    chain.commands = [MotorCmd() for _ in MOTOR_IDS]
+    chain.absolute_positions = None
+    chain.state = None
+    chain.enable_auto_recovery = False
+    chain.same_bus_device_driver = None
+    chain._rate_recorder = Recorder()
+    chain._report_interval = 10.0
+    chain.running = True
+    chain.channel = "fake_can"
+    ref = [chain]
+    chain.motor_interface = ScriptedInterface(make_single(), clock, ref)
+    return chain
+
+
+def run_cycles(chain, cycles):
+    chain.motor_interface.cycles = cycles
+    chain.motor_interface.cycle = 0
+    chain.running = True
+    chain._set_torques_and_update_state()
+
+
+def ok_cycle(base, p_ints=P_INTS):
+    # Per-motor, deliberately non-monotone receive times within the cycle.
+    return {mid: (p, 0x1, base + 0.0013 * ((3 * i) % N)) for i, (mid, p) in enumerate(zip(MOTOR_IDS, p_ints))}
+
+
+def expected_times(base):
+    return np.array([base + 0.0013 * ((3 * i) % N) for i in range(N)])
+
+
+def make_robot(chain):
+    robot = MotorChainRobot.__new__(MotorChainRobot)
+    robot.motor_chain = chain
+    robot._arm_type = "yam"
+    robot._gripper_type = "fake"
+    robot.remapper = JointMapper(index_range_map={6: GRIPPER_LIMITS}, total_dofs=N)
+    robot._state_lock = threading.Lock()
+    robot._gripper_index = 6
+    robot._joint_limits = np.array([[-20.0, 20.0]] * 6)
+    robot._joint_state_saver = None
+    robot._joint_state = robot._motor_state_to_joint_state(chain.read_states())
+    return robot
+
+
+def expected_command_positions():
+    pos = np.array([(raw_pos(p) - OFFSETS[i]) * DIRECTIONS[i] for i, p in enumerate(P_INTS)])
+    pos[6] = (pos[6] - GRIPPER_LIMITS[0]) / (GRIPPER_LIMITS[1] - GRIPPER_LIMITS[0])
+    return pos
+
+
+def test_decode_stamps_only_normal_fully_decoded_frames(clock):
+    single = make_single()
+    clock.mono = 42.5
+    info = single.parse_recv_message(frame(3, 31000), MotorType.DM4310)
+    assert info.received_monotonic_s == 42.5
+    assert info.position == pytest.approx(raw_pos(31000))
+
+    err = single.parse_recv_message(frame(3, 31000, error=0xB), MotorType.DM4310, ignore_error=True)
+    assert err.received_monotonic_s is None
+    with pytest.raises(RuntimeError, match="Motor error detected"):
+        single.parse_recv_message(frame(3, 31000, error=0xB), MotorType.DM4310)
+    short = frame(3, 31000)
+    short.data = short.data[:5]
+    with pytest.raises(IndexError):
+        single.parse_recv_message(short, MotorType.DM4310)
+
+
+def test_read_states_copies_original_times_after_clock_advance(clock):
+    chain = make_chain(clock)
+    run_cycles(chain, [ok_cycle(100.0)])
+    first = chain.read_states()
+    clock.mono += 50.0
+    clock.wall += 50.0
+    second = chain.read_states()
+    np.testing.assert_array_equal([m.received_monotonic_s for m in first], expected_times(100.0))
+    np.testing.assert_array_equal([m.received_monotonic_s for m in second], expected_times(100.0))
+    # The legacy wall-clock stamp is refreshed per read (why it is not freshness proof).
+    assert second[0].timestamp == first[0].timestamp + 50.0
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [RuntimeError("Motor error detected: injected"), AssertionError("fail to communicate with the motor")],
+    ids=["error_reply", "missing_reply"],
+)
+def test_incomplete_or_error_cycle_does_not_republish(clock, bad):
+    chain = make_chain(clock)
+    run_cycles(chain, [ok_cycle(100.0)])
+    before = chain.read_states()
+    broken = ok_cycle(200.0, p_ints=[p + 500 for p in P_INTS])
+    broken[MOTOR_IDS[4]] = bad
+    with pytest.raises(type(bad)):
+        run_cycles(chain, [broken])
+    assert chain.running is False
+    after = chain.read_states()
+    np.testing.assert_array_equal([m.received_monotonic_s for m in after], expected_times(100.0))
+    np.testing.assert_array_equal([m.pos for m in after], [m.pos for m in before])
+
+
+def test_robot_sample_correspondence_mapping_and_unchanged_upper_cache(clock):
+    chain = make_chain(clock)
+    run_cycles(chain, [ok_cycle(100.0)])
+    robot = make_robot(chain)
+    sample = robot.get_joint_sample()
+    np.testing.assert_allclose(sample["joint_state"], expected_command_positions())
+    np.testing.assert_array_equal(sample["received_monotonic_s"], expected_times(100.0))
+    np.testing.assert_array_equal(sample["joint_state"], robot.get_joint_pos())
+
+    # Repeated MotorChainRobot cache updates (no new CAN reply) keep the original times.
+    clock.mono += 9.0
+    clock.wall += 9.0
+    cmds = JointCommands.init_all_zero(N)
+    for _ in range(3):
+        robot._update_joint_state(np.zeros(N), cmds)
+    again = robot.get_joint_sample()
+    np.testing.assert_array_equal(again["received_monotonic_s"], expected_times(100.0))
+    assert robot._joint_state.timestamp == clock.wall  # legacy field still refreshed
+
+    # A fresh complete cycle publishes new positions and times together.
+    run_cycles(chain, [ok_cycle(300.0, p_ints=[p + 700 for p in P_INTS])])
+    robot._update_joint_state(np.zeros(N), cmds)
+    newer = robot.get_joint_sample()
+    np.testing.assert_array_equal(newer["received_monotonic_s"], expected_times(300.0))
+    assert not np.allclose(newer["joint_state"], sample["joint_state"])
+
+
+def test_robot_sample_copy_isolation_lock_bound_and_missing_times(clock):
+    chain = make_chain(clock)
+    run_cycles(chain, [ok_cycle(100.0)])
+    robot = make_robot(chain)
+    sample = robot.get_joint_sample()
+    sample["joint_state"][:] = -99.0
+    sample["received_monotonic_s"][:] = -99.0
+    robot._joint_state.pos[0] = 123.0  # cache mutation after the copy
+    fresh = robot.get_joint_sample()
+    assert fresh["joint_state"][1] != -99.0 and fresh["received_monotonic_s"][1] != -99.0
+    assert sample["joint_state"][0] == -99.0
+
+    assert mcr.JOINT_SAMPLE_LOCK_TIMEOUT_S <= 0.01
+    robot._state_lock.acquire()
+    try:
+        start = time.perf_counter()
+        with pytest.raises(TimeoutError):
+            robot.get_joint_sample()
+        assert time.perf_counter() - start < 0.5
+    finally:
+        robot._state_lock.release()
+
+    robot._joint_state.received_monotonic_s[3] = np.nan
+    with pytest.raises(RuntimeError, match=r"joint\(s\) \[3\]"):
+        robot.get_joint_sample()
+    robot._joint_state.received_monotonic_s = None
+    with pytest.raises(RuntimeError, match="did not provide"):
+        robot.get_joint_sample()
+
+
+def alive():
+    return SimpleNamespace(is_alive=lambda: True)
+
+
+def make_yam(clock, base, p_ints=P_INTS):
+    chain = make_chain(clock)
+    run_cycles(chain, [ok_cycle(base, p_ints)])
+    chain.running = True
+    chain._control_thread = alive()
+    chain._rate_recorder.last_rate = 250.0
+    robot = make_robot(chain)
+    robot._server_thread = alive()
+    return YAMRobot._from_hardware_robot(robot)
+
+
+def test_yam_sample_strict_size_and_health_uses_oldest_receive_time(clock):
